---
import type {
    MortgageCalculatorFragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { isEditContext } from '../../shared/utils.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: MortgageCalculatorFragment;
    displaySettings: DisplaySettingsFragment[];
    contentPayload: ContentPayload;
}
const { key, data } = Astro.props as Props;

const price = data?.DefaultPropertyPrice ?? 450000;
const depositPct = data?.DefaultDepositPercent ?? 15;
const rate = data?.DefaultInterestRate ?? 4.5;
const termYears = data?.DefaultTermYears ?? 25;
const ctaLabel = data?.CtaLabel || 'Speak to a mortgage adviser';
const ctaUrl = data?.CtaUrl || '/book-a-consultation/';

const componentClass = 'component-mortgage-calculator';
---

<div
    class={`mortgage-calc card bg-base-100 border border-base-300 shadow-sm w-full max-w-3xl mx-auto ${componentClass}`}
    data-epi-block-id={(isCmsEdit && key) || undefined}
>
    <div class="card-body">
        {data?.Heading && <h2 class="card-title text-2xl">{data.Heading}</h2>}
        {data?.Intro?.html && (
            <div class="text-base-content/80" set:html={data.Intro.html} />
        )}

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 mt-2">
            <label class="form-control w-full">
                <span class="label-text mb-1 font-medium">Property price (£)</span>
                <input
                    type="number"
                    class="input input-bordered w-full mc-price"
                    min="0"
                    step="1000"
                    value={price}
                />
            </label>
            <label class="form-control w-full">
                <span class="label-text mb-1 font-medium">
                    Deposit (%) — <span class="mc-deposit-amount opacity-70">£0</span>
                </span>
                <input
                    type="number"
                    class="input input-bordered w-full mc-deposit"
                    min="0"
                    max="100"
                    step="0.5"
                    value={depositPct}
                />
            </label>
            <label class="form-control w-full">
                <span class="label-text mb-1 font-medium">Interest rate (% APR)</span>
                <input
                    type="number"
                    class="input input-bordered w-full mc-rate"
                    min="0"
                    step="0.05"
                    value={rate}
                />
            </label>
            <label class="form-control w-full">
                <span class="label-text mb-1 font-medium">Term (years)</span>
                <input
                    type="number"
                    class="input input-bordered w-full mc-term"
                    min="1"
                    max="40"
                    step="1"
                    value={termYears}
                />
            </label>
        </div>

        <div class="stats stats-vertical md:stats-horizontal bg-base-200 mt-6 w-full">
            <div class="stat">
                <div class="stat-title">Monthly repayment</div>
                <div class="stat-value text-primary text-3xl mc-monthly">—</div>
                <div class="stat-desc">capital &amp; interest</div>
            </div>
            <div class="stat">
                <div class="stat-title">Interest-only</div>
                <div class="stat-value text-3xl mc-interest-only">—</div>
                <div class="stat-desc">per month</div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 md:grid-cols-2 mt-4 text-sm">
            <div class="flex justify-between border-b border-base-300 pb-1">
                <span class="opacity-70">Loan amount</span>
                <span class="font-medium mc-loan">—</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-1">
                <span class="opacity-70">Total repaid over term</span>
                <span class="font-medium mc-total">—</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-1">
                <span class="opacity-70">of which interest</span>
                <span class="font-medium mc-total-interest">—</span>
            </div>
            <div class="flex justify-between border-b border-base-300 pb-1">
                <span class="opacity-70">Loan-to-value</span>
                <span class="font-medium mc-ltv">—</span>
            </div>
        </div>

        <p class="mc-note text-sm text-secondary mt-2 hidden"></p>

        <div class="card-actions mt-6 items-center justify-between flex-wrap gap-3">
            <p class="text-xs opacity-60 mb-0">
                Illustrative only — not financial advice.
            </p>
            <a class="btn btn-secondary" href={ctaUrl}>{ctaLabel}</a>
        </div>
    </div>
</div>

<script>
    function initMortgageCalculators() {
        const gbp = new Intl.NumberFormat('en-GB', {
            style: 'currency',
            currency: 'GBP',
            maximumFractionDigits: 0,
        });

        document
            .querySelectorAll<HTMLElement>('.mortgage-calc')
            .forEach((calc) => {
                if (calc.dataset.mcInit === 'true') return;
                calc.dataset.mcInit = 'true';

                const q = <T extends HTMLElement>(sel: string) =>
                    calc.querySelector(sel) as T;
                const priceEl = q<HTMLInputElement>('.mc-price');
                const depositEl = q<HTMLInputElement>('.mc-deposit');
                const rateEl = q<HTMLInputElement>('.mc-rate');
                const termEl = q<HTMLInputElement>('.mc-term');

                const num = (el: HTMLInputElement) => {
                    const v = parseFloat(el?.value);
                    return Number.isFinite(v) && v > 0 ? v : 0;
                };

                const update = () => {
                    const price = num(priceEl);
                    const depositPct = Math.min(num(depositEl), 100);
                    const rate = num(rateEl);
                    const years = Math.floor(num(termEl));

                    const depositAmount = (price * depositPct) / 100;
                    const loan = Math.max(price - depositAmount, 0);
                    const n = years * 12;
                    const r = rate / 100 / 12;

                    let monthly = 0;
                    let interestOnly = 0;
                    if (loan > 0 && n > 0) {
                        monthly =
                            r === 0
                                ? loan / n
                                : (loan * r) / (1 - Math.pow(1 + r, -n));
                        interestOnly = loan * r;
                    }
                    const total = monthly * n;
                    const totalInterest = Math.max(total - loan, 0);
                    const ltv = price > 0 ? (loan / price) * 100 : 0;

                    q('.mc-deposit-amount').textContent = gbp.format(depositAmount);
                    q('.mc-monthly').textContent =
                        loan > 0 && n > 0 ? gbp.format(monthly) : '—';
                    q('.mc-interest-only').textContent =
                        loan > 0 ? gbp.format(interestOnly) : '—';
                    q('.mc-loan').textContent = gbp.format(loan);
                    q('.mc-total').textContent =
                        loan > 0 && n > 0 ? gbp.format(total) : '—';
                    q('.mc-total-interest').textContent =
                        loan > 0 && n > 0 ? gbp.format(totalInterest) : '—';
                    q('.mc-ltv').textContent = `${ltv.toFixed(1)}%`;

                    const note = q('.mc-note');
                    if (price > 0 && depositAmount >= price) {
                        note.textContent =
                            'Your deposit covers the full property price — no mortgage needed.';
                        note.classList.remove('hidden');
                    } else if (price === 0 || years === 0) {
                        note.textContent =
                            'Enter a property price and term to see your repayments.';
                        note.classList.remove('hidden');
                    } else {
                        note.classList.add('hidden');
                    }
                };

                [priceEl, depositEl, rateEl, termEl].forEach((el) =>
                    el?.addEventListener('input', update)
                );
                update();
            });
    }

    document.addEventListener('astro:page-load', initMortgageCalculators);
    initMortgageCalculators();
</script>
